{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice by Superteem",
  "version": "0.8.4",
  "identifier": "io.superteem.voice",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voice by Superteem",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost; img-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Superteem",
    "homepage": "https://voice.superteem.com",
    "license": "GPL-3.0-only",
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.4",
      "frameworks": ["Accelerate", "AudioToolbox", "AVFAudio", "CoreBluetooth"]
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
