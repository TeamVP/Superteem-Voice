  "changes": [
    {
      "version": 1,
      "date": "2026-11-13",
      "summary": "Added to the library, with each life as a chapter under its book."
    },
    {
      "version": 2,
      "date": "2026-11-13",
      "summary": "Built into the app, so it appears on every device, Android included."
    },
    {
      "version": 3,
      "date": "2026-11-14",
      "summary": "Suggests a voice to read it, and how to say the names the voices get wrong."
    },
    {
      "version": 4,
      "date": "2026-11-14",
      "summary": "Names respelled from what the voice actually says, and left alone where it already says them well."
    },
    {
      "version": 5,
      "date": "2026-11-14",
      "summary": "Commentary on the book and on Theseus, and Theseus's own pronunciations."
    },
    {
      "version": 6,
      "date": "2026-11-14",
      "summary": "Says who wrote and translated it, where the text came from and that it's in the public domain. The preface names its author."
    },
    {
      "version": 7,
      "date": "2026-11-14",
      "summary": "Links to its source at Project Gutenberg, which opens in your browser after saying it leaves the app."
    },
    {
      "version": 8,
      "date": "2026-11-14",
      "summary": "Themistocles and Caesar gain commentary, with when each lived in our own calendar and what else was happening in the world, and their own pronunciations of the names in them. Where a chapter says a name its own way, that's used in place of the book's."
    },
    {
      "version": 9,
      "date": "2026-11-14",
      "summary": "Easier, more natural ways of saying the names in Themistocles and Caesar, and Themistocles said as Thur-mistic-klees."
    },
    {
      "version": 10,
      "date": "2026-11-15",
      "summary": "A cover, and pictures: timelines in the commentaries on Themistocles and Caesar, all in the book's gallery."
    },
    {
      "version": 11,
      "date": "2026-11-15",
      "summary": "A register of the book's pictures: who made each, its rights and why it may be used, where it came from and every change since."
    }
  ],
